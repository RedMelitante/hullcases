---
// AnnouncementBar + SiteHeader + MegaMenu + MobileNavDrawer (design/source/SiteHeader.dc.html)
import Icon from './Icon.astro';
import { ROUTES, SITE, SHOP_FILTERS } from '../data/site';
import { POST_BY_KEY, postUrl } from '../data/posts';

export type NavKey = 'home' | 'shop' | 'custom' | 'about' | 'contact' | 'blog' | 'none';
interface Props {
  active?: NavKey;
}
const { active = 'none' } = Astro.props;
const cls = (k: NavKey) => (active === k ? 'is-active' : undefined);
const mlinkStyle = 'display: flex; align-items: center; min-height: 44px; text-decoration: none; font-size: 17px';
const searchBtnStyle =
  'position: absolute; left: 2px; top: 50%; transform: translateY(-50%); width: 42px; height: 42px; display: flex; align-items: center; justify-content: center; color: #4A5159; z-index: 1; border: 0; background: none; padding: 0; cursor: pointer; border-radius: 4px';
---
<div class="ann"><b>Waterproof IP67 cases</b> · Ships from Mira Loma, CA · Local pickup available</div>
<header class="hdr" data-header>
  <div class="wrap hdr-row">
    <button class="icon-btn only-t-flex" style="display: none" type="button" aria-label="Open menu" aria-controls="mobile-nav" aria-expanded="false" data-open-mobile-nav>
      <Icon name="menu" />
    </button>
    <a class="logo" href={ROUTES.home}><img class="logo-img" src="/images/logo-dark.png" alt="Hull Cases home" width="170" height="40" /></a>
    <nav class="nav" aria-label="Main">
      <button type="button" class={cls('shop')} aria-expanded="false" aria-controls="mega-menu" data-mega-toggle>
        Shop<Icon name="chevron" width={18} height={18} strokeWidth={2.4} />
      </button>
      <a href={ROUTES.custom} class={cls('custom')} aria-current={active === 'custom' ? 'page' : undefined}>Custom Cases</a>
      <a href={ROUTES.about} class={cls('about')} aria-current={active === 'about' ? 'page' : undefined}>About</a>
      <a href={ROUTES.contact} class={cls('contact')} aria-current={active === 'contact' ? 'page' : undefined}>Contact</a>
    </nav>
    <form class="search" role="search" action={ROUTES.shop} method="get">
      <label for="hdr-search" class="sr-only">Search cases</label>
      <button type="submit" aria-label="Search" style={searchBtnStyle}>
        <Icon name="search" style="position: static; transform: none; width: 22px; height: 22px" />
      </button>
      <input id="hdr-search" name="q" class="input" type="search" placeholder="Search cases by name or size" autocomplete="off" />
    </form>
    <div class="hdr-icons">
      <button class="icon-btn only-t-flex" style="display: none" type="button" aria-label="Search" aria-controls="mobile-nav" data-open-mobile-nav data-focus-search>
        <Icon name="search" />
      </button>
      <a class="icon-btn" href={ROUTES.account} aria-label="Account"><Icon name="user" /></a>
      <a class="icon-btn" href={ROUTES.cart} aria-label="Cart, 0 items" data-cart-open>
        <Icon name="cart" /><span class="cart-count" data-cart-count hidden>0</span>
      </a>
    </div>
  </div>

  <div class="mega" id="mega-menu" hidden data-mega>
    <div class="wrap mega-grid">
      <div>
        <h3>Shop by category</h3>
        <a href={SHOP_FILTERS.small.href}>Small cases</a>
        <a href={SHOP_FILTERS.medium.href}>Medium cases</a>
        <a href={SHOP_FILTERS.large.href}>Large cases</a>
        <a href={SHOP_FILTERS.wheeled.href}>Wheeled cases</a>
        <a href={ROUTES.shop} class="link" style="font-weight: 600">All cases</a>
      </div>
      <div>
        <h3>Shop by inside length</h3>
        <a href={SHOP_FILTERS['under-12'].href}>Under 12 in</a>
        <a href={SHOP_FILTERS['12-16'].href}>12–16 in</a>
        <a href={SHOP_FILTERS['16-20'].href}>16–20 in</a>
        <a href={SHOP_FILTERS['over-20'].href}>Over 20 in</a>
      </div>
      <div>
        <h3>Shop by use</h3>
        <a href={postUrl(POST_BY_KEY.camera)}>Photo &amp; video</a>
        <a href={postUrl(POST_BY_KEY.tactical)}>Tactical &amp; field work</a>
        <a href={postUrl(POST_BY_KEY.utility)}>Tools &amp; trades</a>
        <a href={SHOP_FILTERS.travel.href}>Travel</a>
      </div>
      <div>
        <h3>Help choosing</h3>
        <a href={ROUTES.faq}>Sizing FAQ</a>
        <a href={ROUTES.returns}>Shipping &amp; returns</a>
        <a href={ROUTES.blog}>Guides &amp; articles</a>
        <a href={SITE.phoneHref}>Call {SITE.phone}</a>
        <a href={SITE.emailHref}>{SITE.email}</a>
      </div>
      <a href={ROUTES.shop} class="stack" style="gap: 12px; text-decoration: none; min-height: 0; align-items: stretch">
        <img src="/images/stacked-black-yellow.jpg" alt="Yellow and black Hull cases stacked" loading="lazy" decoding="async" style="display: block; width: 100%; aspect-ratio: 16/10; object-fit: cover; border-radius: 8px" />
        <span class="h4" style="font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 22px; text-transform: uppercase">Waterproof cases in black and yellow</span>
        <span class="link" style="font-size: 16px">Shop now</span>
      </a>
    </div>
  </div>
</header>

<div class="mnav" id="mobile-nav" hidden data-mobile-nav>
  <div class="scrim" data-close-mobile-nav></div>
  <nav class="drawer drawer-left" aria-label="Mobile" style="width: 340px" role="dialog" aria-modal="true">
    <div class="drawer-hd">
      <a class="logo" href={ROUTES.home}><img src="/images/logo-dark.png" alt="Hull Cases home" width="136" height="32" style="height: 32px; width: auto; display: block" /></a>
      <button class="icon-btn" type="button" aria-label="Close menu" data-close-mobile-nav><Icon name="close" /></button>
    </div>
    <div class="drawer-bd">
      <form role="search" class="search" style="display: block; max-width: none; margin: 12px 0 8px" action={ROUTES.shop} method="get">
        <label for="m-search" class="sr-only">Search cases</label>
        <button type="submit" aria-label="Search" style={searchBtnStyle}>
          <Icon name="search" style="position: static; transform: none; width: 22px; height: 22px" />
        </button>
        <input id="m-search" name="q" class="input" type="search" placeholder="Search cases" autocomplete="off" />
      </form>
      <details class="acc" open style="border-top: 0">
        <summary class="mlink" style="border: 0; min-height: 56px; padding: 0">Shop<Icon name="plus" class="acc-ico" /></summary>
        <div class="stack" style="padding: 0 0 12px 4px">
          <a href={SHOP_FILTERS.small.href} style={mlinkStyle}>Small cases</a>
          <a href={SHOP_FILTERS.medium.href} style={mlinkStyle}>Medium cases</a>
          <a href={SHOP_FILTERS.large.href} style={mlinkStyle}>Large cases</a>
          <a href={SHOP_FILTERS.wheeled.href} style={mlinkStyle}>Wheeled cases</a>
          <a href={ROUTES.shop} class="link" style="display: flex; align-items: center; min-height: 44px; font-size: 17px">All cases</a>
        </div>
      </details>
      <a class="mlink" href={ROUTES.custom}>Custom Cases</a>
      <a class="mlink" href={ROUTES.about}>About</a>
      <a class="mlink" href={ROUTES.blog}>Blog</a>
      <a class="mlink" href={ROUTES.contact}>Contact</a>
      <a class="mlink" href={ROUTES.faq}>FAQ</a>
      <a class="mlink" href={ROUTES.account}>Account</a>
    </div>
    <div class="drawer-ft">
      <a class="btn btn-ghost btn-block" href={SITE.phoneHref}><Icon name="phone" />{SITE.phone}</a>
      <p class="t-sm muted" style="margin: 0; text-align: center">{SITE.email}</p>
    </div>
  </nav>
</div>
