---
// CartDrawer + CartLineItem + CartEmpty (design/source/CartDrawer.dc.html). Lines are rendered by src/scripts/ui.ts.
import Icon from './Icon.astro';
import { ROUTES } from '../data/site';
---
<div class="mnav" id="cart-drawer" hidden data-cart-drawer>
  <div class="scrim" data-close-cart></div>
  <aside class="drawer" role="dialog" aria-modal="true" aria-labelledby="cart-title">
    <div class="drawer-hd">
      <h2 id="cart-title" class="h3" style="font-size: 28px; text-transform: uppercase">Your cart <span class="muted" style="font-weight: 600">(<span data-cart-drawer-count>0</span>)</span></h2>
      <button class="icon-btn" type="button" aria-label="Close cart" data-close-cart><Icon name="close" /></button>
    </div>

    <div class="drawer-bd stack" style="align-items: center; justify-content: center; text-align: center; gap: 16px; padding: 40px 24px" data-cart-empty>
      <Icon name="cart" style="width: 64px; height: 64px" stroke="#4A5159" strokeWidth={1.5} />
      <h3 class="h3">Your cart is empty</h3>
      <p class="body muted" style="max-width: 18rem">Find a case that fits your gear, then come back here to check out.</p>
      <a class="btn btn-primary" href={ROUTES.shop}>Continue shopping</a>
    </div>

    <ul class="drawer-bd" style="list-style: none; margin: 0" data-cart-lines hidden></ul>
    <div class="drawer-ft" data-cart-footer hidden>
      <div class="row" style="justify-content: space-between; align-items: baseline"><span style="font-weight: 600; font-size: 18px">Subtotal</span><span class="price" data-cart-subtotal>$0.00</span></div>
      <p class="t-sm muted" style="margin: 0">Shipping and taxes are calculated at checkout. Prices in USD.</p>
      <a class="btn btn-primary btn-block" href={ROUTES.checkout}>Go to checkout</a>
      <a class="btn btn-ghost btn-block" href={ROUTES.cart}>View cart</a>
    </div>
  </aside>
</div>
