---
// CartPage + CartSummary (design/source/Cart.dc.html)
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ROUTES } from '../../data/site';
---
<BaseLayout title="Cart | Hull Cases" description="Your Hull Cases shopping cart." noindex>
  <main id="main" class="wrap" style="padding-bottom: 96px" data-cart-page>
    <nav class="crumbs" aria-label="Breadcrumb"><a href={ROUTES.home}>Home</a><span aria-hidden="true">/</span><span aria-current="page">Cart</span></nav>
    <h1 class="h1" style="margin: 8px 0 32px">Your cart</h1>
    <div class="stack" style="align-items: center; text-align: center; gap: 16px; padding: 72px 24px; border: 1px solid #DDE0E4; border-radius: 8px" data-cart-page-empty>
      <h2 class="h3">Your cart is empty</h2>
      <p class="body muted">Find a case that fits your gear, then come back here to check out.</p>
      <a class="btn btn-primary" href={ROUTES.shop}>Continue shopping</a>
    </div>
    <div class="g2 g2-l" style="gap: 48px; align-items: start" data-cart-page-full hidden>
      <div>
        <ul class="stack" style="list-style: none; margin: 0; padding: 0; gap: 0; border-top: 2px solid #16181B" data-cart-page-lines></ul>
        <a class="link" href={ROUTES.shop} style="display: inline-flex; margin-top: 20px">Continue shopping</a>
      </div>
      <aside class="stack" style="gap: 14px; padding: 28px; background: #F5F6F7; border-radius: 8px">
        <h2 class="h3">Order summary</h2>
        <div class="row" style="justify-content: space-between"><span class="muted">Subtotal (<span data-cart-page-count>0</span> items)</span><span class="num" style="font-weight: 600" data-cart-page-subtotal>$0.00</span></div>
        <div class="row" style="justify-content: space-between"><span class="muted">Shipping</span><span>Calculated at checkout</span></div>
        <div class="row" style="justify-content: space-between"><span class="muted">Tax</span><span>Calculated at checkout</span></div>
        <div class="row" style="justify-content: space-between; border-top: 2px solid #16181B; padding-top: 14px"><span style="font-weight: 700">Total (USD)</span><span class="price" data-cart-page-total>$0.00</span></div>
        <a class="btn btn-primary btn-block" href={ROUTES.checkout}>Go to checkout</a>
        <ul class="stack" style="list-style: none; margin: 0; padding: 0; gap: 8px">
          <li class="t-sm muted">Ships from Mira Loma, CA via UPS, FedEx or freight</li>
          <li class="t-sm muted">30-day returns with RMA · Lifetime warranty</li>
        </ul>
      </aside>
    </div>
  </main>
</BaseLayout>

<script>
  import { detailed, money, type DetailedLine } from '../../scripts/cart';
  import { svg } from '../../scripts/icons';
  import { esc } from '../../scripts/ui';

  const line = (it: DetailedLine) => `<li class="row" style="gap: 16px; align-items: flex-start; padding: 20px 0; border-bottom: 1px solid #DDE0E4">
<img src="${it.img}" alt="" width="96" height="96" style="width: 96px; height: 96px; object-fit: contain; padding: 6px; box-sizing: border-box; border: 1px solid #DDE0E4; border-radius: 4px; background: #FFFFFF; flex: none">
<div class="stack" style="gap: 10px; flex: 1; min-width: 0">
<div class="row" style="justify-content: space-between; align-items: flex-start; gap: 12px">
<div class="stack" style="gap: 4px; min-width: 0"><a href="${it.href}" style="font-weight: 600; text-decoration: none">${esc(it.title)}</a><span class="t-sm muted">${esc(it.variant)}</span><span class="t-sm muted">${money(it.unit)} each</span></div>
<span class="num" style="font-weight: 600; white-space: nowrap">${money(it.line)}</span>
</div>
<div class="row" style="gap: 12px">
<div class="qty qty-sm" role="group" aria-label="Quantity, ${esc(it.title)}"><button type="button" aria-label="Decrease quantity" data-qty-dec="${it.m}">${svg('minus', 2.2)}</button><output aria-live="polite">${it.qty}</output><button type="button" aria-label="Increase quantity" data-qty-inc="${it.m}">${svg('plus', 2.2)}</button></div>
<button class="icon-btn" type="button" aria-label="Remove ${esc(it.title)}" data-remove="${it.m}">${svg('trash')}</button>
</div>
</div>
</li>`;

  const root = document.querySelector<HTMLElement>('[data-cart-page]')!;
  const q = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  function render() {
    const { items, count, subtotalText } = detailed();
    q('[data-cart-page-empty]').hidden = items.length > 0;
    q('[data-cart-page-full]').hidden = items.length === 0;
    q('[data-cart-page-lines]').innerHTML = items.map(line).join('');
    q('[data-cart-page-count]').textContent = String(count);
    q('[data-cart-page-subtotal]').textContent = subtotalText;
    q('[data-cart-page-total]').textContent = subtotalText;
  }
  window.addEventListener('cart:change', render);
  render();
</script>
