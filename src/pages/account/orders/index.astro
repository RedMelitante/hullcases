---
// AccountNav + OrderHistoryTable (design/source/AccountOrders.dc.html)
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ROUTES } from '../../../data/site';
---
<BaseLayout title="My orders | Hull Cases" description="Your Hull Cases order history." noindex>
  <main id="main" class="wrap" style="padding-bottom: 96px">
    <nav class="crumbs" aria-label="Breadcrumb"><a href={ROUTES.home}>Home</a><span aria-hidden="true">/</span><a href={ROUTES.account}>Account</a><span aria-hidden="true">/</span><span aria-current="page">Orders</span></nav>
    <div class="shop-layout" style="padding-top: 16px">
      <nav class="stack" aria-label="Account" style="gap: 4px">
        <span class="eyebrow" style="color: #4A5159; margin-bottom: 8px">My account</span>
        <a href={ROUTES.accountOrders} class="mlink" style="font-size: 20px; color: #B4470E" aria-current="page">Orders</a>
        <a href={ROUTES.checkout} class="mlink" style="font-size: 20px">Addresses</a>
        <a href={ROUTES.account} class="mlink" style="font-size: 20px">Profile</a>
        <a href={ROUTES.account} class="mlink" style="font-size: 20px">Sign out</a>
      </nav>
      <div class="stack" style="gap: 24px">
        <h1 class="h1">My orders</h1>
        <div style="overflow-x: auto">
          <table class="table">
            <thead><tr><th scope="col">Order</th><th scope="col">Date</th><th scope="col">Status</th><th scope="col" style="text-align: right">Total</th><th scope="col"><span class="sr-only">Details</span></th></tr></thead>
            <tbody data-orders>
              <tr><td colspan="5" class="muted">You haven’t placed any orders yet.</td></tr>
            </tbody>
          </table>
        </div>
        <div class="row" style="gap: 12px; flex-wrap: wrap">
          <a class="btn btn-primary" href={ROUTES.shop}>Shop cases</a>
          <a class="btn btn-ghost" href={ROUTES.returns}>Start a return</a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import { getOrders, money } from '../../../scripts/cart';
  import { ROUTES } from '../../../data/site';

  const orders = getOrders();
  const tbody = document.querySelector<HTMLElement>('[data-orders]');
  if (tbody && orders.length) {
    tbody.innerHTML = orders
      .map(
        (o) => `<tr><td style="font-weight: 600">#${o.id}</td><td>${new Date(o.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</td><td><span class="badge badge-low"><span class="dot"></span>Processing</span></td><td class="num" style="text-align: right">${money(o.subtotal)}</td><td style="text-align: right"><a class="link" href="${ROUTES.orderConfirmed}?order=${encodeURIComponent(o.id)}">View</a></td></tr>`,
      )
      .join('');
  }
</script>
