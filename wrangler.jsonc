{
  // Static site: Cloudflare serves the built ./dist folder directly (no Worker code, no adapter).
  "name": "hullcases",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Needed by "npx wrangler preview", which Cloudflare runs for pull-request preview builds.
  "previews": {}
}
